---
import Bluesky from "components/SocialIcons/Bluesky.astro";
import Facebook from "components/SocialIcons/Facebook.astro";
import Instagram from "components/SocialIcons/Instagram.astro";

import Logo from "./Header/Logo.astro";

const footerLinks: { hash: string, label: string }[] = [
  {hash: '#story', label: 'Our Story'},
  {hash: '#how', label: 'How it Works'},
  {hash: '#whatson', label: 'What\'s On'},
  {hash: '#faq', label: 'FAQ'},
]; 

---
<footer class="footer" aria-label="Footer">
    <div class="container">
      <div class="footer__inner">
        <div class="footer__row">
          <div class="footer__logo">
            <a href="#main">
              <Logo id="footer-logo"/>
            </a>
          </div>
          <nav class="footer__nav">
          <ul class="footer__links">
            { 
              footerLinks.map(link => (
                <li>
                  <a class="footer__link" href={link.hash}>{link.label}</a> 
                </li>
              ))
            }
          </ul>
          </nav>
      </div>
      <div class="footer__row">
        <ul class="footer__social">
          <li class="footer__social-icon">
            <a aria-label="Breezeway on Instagram">
            <Instagram/>
            </a>
          </li>
          <li class="footer__social-icon">
            <a aria-label="Breezeway on Facebook">
            <Facebook/>
            </a>
          </li>
          <li class="footer__social-icon">
            <a aria-label="Breezeway on BlueSky">
            <Bluesky/>
            </a>
          </li>
        </ul>
        <p class="footer__disclaimer">
          © 2026 Nile Miller · A fictional concept designed and developed by Nile Miller.
        </p>
        <a href="#main" class="footer__back-btn">
          Back to Top ↑
        </a>
      </div>
    </div>
    </div>
</footer>

<style>
  .footer {
    --footer-bg: var(--color-ink); 
    --footer-height: 13rem; 
    background-color: var(--footer-bg);
    position: relative;
    padding-block: var(--space-xs);
  }

  .footer__inner {
    display: grid; 
    align-items: center;
    min-height: var(--footer-height);
  }

  .footer__logo {
    color: var(--color-paper); 
    width: 13rem;

    svg.logo {
      width: 100%; 
      height: auto; 
    }
  }

  .footer__row {
    display: flex; 
    align-items: center;
    justify-content: space-between;
  }

  .footer__links {
    color: var(--color-paper); 
    list-style: none; 
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
  }

  .footer__link {
    position: relative; 

    &::after { 
      position: absolute; 
      content: ''; 
      inset-inline: 0; 
      height: 3px; 
      background: var(--color-paper);
      bottom: 0; 
      clip-path: inset(0 100% 0 0); 
      transition: clip-path .3s cubic-bezier(0.445, 0.05, 0.55, 0.95);
    }

    &:hover::after {
      clip-path: inset(0); 
    }
  }

  .footer__row:last-child {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .footer__social {
    display: flex;
    gap: var(--space-xs);
    list-style: none; 
  }

  .footer__social-icon {
    color: var(--color-paper); 
    width: 1.2rem; 
  }

  .footer__social-icon a {
    display: grid;
    place-items: center;

    inline-size: 2.5rem;
    block-size: 2.5rem;

    svg {
    inline-size: 1.2rem;
    block-size: 1.2rem;
  }
  }

  .footer__back-btn {
    border-radius: .65rem;
    color: var(--color-ink);
    background-color: var(--color-paper); 
    padding-inline: var(--space-2xs);
    padding-block: var(--space-3xs);
    justify-self: end; 
  }

  .footer__disclaimer {
    font-size: var(--fs-s);
    color: var(--color-paper);
     text-align: center;
  }

  .footer a:focus-visible {
  outline: 2px solid var(--color-paper);
  outline-offset: 4px;
}

@media (width < 54rem) {
  .footer__row:first-child {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__links {
    flex-wrap: wrap;
  }

  .footer__row:last-child {
    grid-template-columns: 1fr auto;
    row-gap: var(--space-s);
  }

  .footer__disclaimer {
    grid-column: 1 / -1;
    grid-row: 2;
    text-align: start;
  }

  .footer__back-btn {
    justify-self: end;
  }
}

</style>