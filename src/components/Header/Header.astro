---
import Logo from "./Logo.astro";
import NavToggle from "./NavToggle.astro";

const navItems: { hash: string, label: string }[] = [
  {hash: '#story', label: 'Our Story'},
  {hash: '#how', label: 'How it Works'},
  {hash: '#yourday', label: 'Your Day'},
  {hash: '#whatson', label: 'What\'s On'},
  {hash: '#faq', label: 'FAQ'},
]
---

<header class="header">
  <div class="container--wide">
    <div class="header__inner">
      <a class="header__brand" href="#main">
        <Logo />
      </a>
      <button
        class="header__toggle"
        data-nav-toggle
        aria-controls="primary-nav"
        aria-expanded="false"
        type="button"
      >
        <span class="sr-only">Menu</span>
        <NavToggle />
      </button>
      <nav class="header__nav" id="primary-nav">
        <ul 
          class="header__list"
          >
          {
            navItems.map(item => (
              <li class="header__item">
                <a class="header__link" href={item.hash}>{item.label}</a>
              </li>
            ))
          }
        </ul>
        <a class="header__cta" href="#visit">Visit Breezeway</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    color: var(--color-ink);
    position: sticky;
    top: 0; 
    height: calc(var(--header-h) + var(--nav-gap));
    padding-top: var(--nav-gap);
    z-index: 999;
    background-color: oklch(from var(--color-paper) l c h / .98);
  }

  .header__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    align-items: center;
  }

  .header__toggle {
    border: none;
    width: 25px;
    height: 25px;
    margin-inline-start: auto;
    transform: translateY(-0.5rem);
  }

  .header__nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 999;
    padding-inline: var(--page-gutter);
    padding-block-start: var(--space-md);
    padding-block-end: var(--space-xs);
    display: none;
    background-color: var(--color-paper);
    white-space: nowrap;
    box-shadow: 
      0 .8px 1px -.2px oklch(from var(--shadow-color) l c h / .4), 
      0 4px 5px -4px oklch(from var(--shadow-color) l c h / .4);  

    &[data-open] {
      display: flex;
      flex-direction: column;
      gap: var(--space-s);
      opacity: 1;
      transition:
        0.3s display allow-discrete,
        0.3s opacity allow-discrete;

      @starting-style {
        opacity: 0;
      }
    }
  }

  .header__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-end: var(--space-2xs);
  }

  .header__nav[data-open] .header__item:not(:last-child) {
    border-block-end: 1px solid oklch(from currentColor calc(l + 0.2) c h);

    .header__link {
      display: block;
    }
  }

  .header__cta {
    color: var(--color-accent);
    background-color: var(--color-paper);
    border-radius: var(--radius-pill);
    padding-inline: var(--space-md);
    padding-block: var(--space-3xs);
    text-wrap: nowrap;
    border: 1px solid;
    transition: .3s ease background-color, .3s ease color;  

    &:hover, &.header__link--active {
      color: var(--color-paper-text);
      background-color: var(--color-accent);
    }

    .header__nav[data-open] & {
      display: block;
      align-self: start;
    }
  }

  @media (width >= 55rem) {
    .header__inner {
      grid-template-columns: auto 1fr auto;
    }

    .header__toggle {
      display: none;
    }

    .header__item {
      font-size: inherit;
      position: relative;
      transition: 0.2s ease color;

      &:hover {
        color: var(--color-accent);
      }
    }

    .header__nav,
    .header__nav[data-open] {
      position: static;
      inset: auto;
      padding-inline: 0;
      display: contents;
      font-size: inherit;
    }

    .header__list {
      list-style: none;
      flex-direction: row;
      gap: var(--space-md);
      width: 100%;
      justify-content: center;
    }

    .header__link--active {
      position: relative; 
      color: var(--color-accent);
    }

    .header__link--active:not(.header__cta)::after {
        content: "";
        position: absolute;

        inset-inline: 0;
        inset-block-end: -0.3em;
        height: 0.4em;

        background: var(--color-accent);

        mask-image: url("../../assets/images/embellishments/short-line.svg");
        mask-repeat: no-repeat;
        mask-position: center;
        mask-size: 3rem 1rem;

        pointer-events: none;
        clip-path: inset(0 100% 0 0);
        animation: .3s ease fadeMaskIn both; 
      }

      @keyframes fadeMaskIn {
        from {
          clip-path: inset(0 100% 0 0);
        } to {
          clip-path: inset(0);
        }
      }
  }
</style>

<script>
  import { gsap, reduced } from "scripts/gsap";
  import { initScrollSpy } from "scripts/scrollSpy";

  const setupNav = () => {
    const header = document.querySelector(".header");
    if (!header) return;

    const navToggle = header.querySelector(
      "[data-nav-toggle]",
    ) as HTMLButtonElement;
    const navMenu = header.querySelector(".header__nav");
    if (!navToggle || !navMenu) return;

    const menuItems = navMenu.querySelectorAll(".header__item, .header__cta");
    const getMenuOpen = () =>
      navToggle.getAttribute("aria-expanded") === "true";

    const prefersReduced = reduced(); 

    const openMenu = () => {
      navToggle.setAttribute("aria-expanded", "true");
      navMenu.setAttribute("data-open", "true");

      if (prefersReduced) return;
      gsap.killTweensOf(menuItems);
      gsap.fromTo(
        menuItems,
        {
          x: -100,
          opacity: 0,
        },
        {
          x: 0,
          opacity: 1,
          stagger: 0.05,
          duration: 1.2,
          ease: "elastic.out(1,0.75)",
        },
      );
    };

    const closeMenu = () => {
      navToggle.setAttribute("aria-expanded", "false");

      if (prefersReduced) {
        navMenu.removeAttribute("data-open");
        return;
      }

      const tl = gsap.timeline();

      gsap.killTweensOf(menuItems);

      tl.to(menuItems, {
        x: -100,
        stagger: -0.05,
        opacity: 0,
        duration: 0.5,
        ease: "power2.in(1,0.25)",
        onComplete: () => {
          navMenu.removeAttribute("data-open");
          gsap.set(navMenu, { clearProps: "opacity" });
        },
      })
    };

    const resetMenu = () => {
      gsap.killTweensOf(menuItems);
      gsap.set(menuItems, { clearProps: "transform,opacity" });
      navToggle.setAttribute("aria-expanded", "false");
      navMenu.removeAttribute("data-open");
    };

    const handleNavToggleClick = () => {
      const currOpen = navToggle.getAttribute("aria-expanded") === "true";
      const nextOpen = !currOpen;

      if (nextOpen) {
        openMenu();
      } else {
        closeMenu();
      }
    };

    navToggle.addEventListener("click", handleNavToggleClick);

    window.addEventListener("keydown", (e: KeyboardEvent) => {
      const isMenuOpen = getMenuOpen();
      if (e.key === "Escape" && isMenuOpen) {
        resetMenu();
        navToggle.focus();
      }
    });

    const desktop = window.matchMedia("(min-width: 55rem)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) {
        resetMenu();
      }
    });

    const handleClickOutside = (e: PointerEvent) => {
      const target = e.target as Node;
      const isMenuOpen = getMenuOpen();

      if (
        isMenuOpen &&
        !navMenu.contains(target) &&
        !navToggle.contains(target)
      ) {
        closeMenu();
      }
    };

    document.addEventListener("pointerdown", handleClickOutside);
  };

  setupNav();
  initScrollSpy()
</script>
