---
import { getImage } from "astro:assets";

import Asterisk from "./Asterisk.astro";
import Swoosh from "./Swoosh.astro";

import cardOverlay from "assets/images/embellishments/notecardoverlay.jpeg";

const overlay = await getImage({ 
  src: cardOverlay, 
  format: 'webp',
  width: 600
}); 

const benefits = [
  'Unlimited coffee and snacks',
  'All-you-can-play board games',
  'Free and fast WiFi',
  'The comfiest seats in the neighborhood'
]; 

const price = 5; 

---

<div class="pricing-card" data-pricing-card data-parallax>
  <div class="pricing-card__header">
    <h3>What's included</h3>
  </div>
  <div class="pricing-card__body">
    <ul data-benefits>
      {
        benefits.map(benefit => (
          <li><div aria-hidden="true" class="pricing-card__bullet"><Asterisk/></div>{benefit}</li>
        ))
      }
    </ul>
    <div class="pricing-card__bottom" data-card-bottom>
      <div class="pricing-card__stamp">
        <span class="pricing-card__price"><sup>$</sup>{price} / hour</span>
        <svg
          class="pricing-card__stamp-border"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 209.01 150.77"
        >
          <defs>
            <filter
              id="worn-displacement"
              x="-5%"
              y="-8%"
              width="110%"
              height="116%"
              color-interpolation-filters="sRGB"
            >
              <feTurbulence
                type="fractalNoise"
                baseFrequency="0.018 0.075"
                numOctaves="3"
                seed="12"
                result="noise"></feTurbulence>

              <feGaussianBlur in="noise" stdDeviation="0.35" result="soft-noise"
              ></feGaussianBlur>

              <feDisplacementMap
                in="SourceGraphic"
                in2="soft-noise"
                scale="4.2"
                xChannelSelector="R"
                yChannelSelector="G"></feDisplacementMap>
            </filter>
          </defs>

          <g id="sticker" filter="url(#worn-displacement)">
            <rect
              x=".5"
              y=".5"
              width="208.01"
              height="149.77"
              rx="3.09"
              ry="3.09"
              fill="currentColor"
              stroke="#a35c44"
              stroke-miterlimit="10"></rect>
          </g>
        </svg>
      </div>
      <div class="pricing-card__notes">
        <div class="pricing-card__notes-line">
          <Swoosh/>
        </div>
        <div class="pricing-card__discounts">
          Daily pricing, sliding scale, and student/senior discounts available.
        </div>
        
      </div>
    </div>
  </div>
</div>

<style define:vars={{
  overlay: `url("${overlay.src}")`
}}>
  .pricing-card {
    width: clamp(23rem, 42vw, 55rem);
    display: flex;
    flex-direction: column;
    background-color: oklch(98.51% 0 0); 
    border-radius: 3px;
    container-type: inline-size; 
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(60, 45, 25, 0.1),
      0 10px 24px -8px rgba(60, 45, 25, 0.2);
    position: relative;
    font-family: var(--font-typewriter);
  }

  .pricing-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--overlay);
    mix-blend-mode: multiply;
    pointer-events: none;
    opacity: 0.2;
    background-size: cover;
  }

  .pricing-card__header {
    height: 10%;
    border-bottom: 1px solid rgba(168, 74, 72, 0.45);
    color: rgba(168, 74, 72);
    font-size: 1.4rem;
    padding-block: var(--space-3xs);
    display: flex;
    justify-content: center;
    align-items: end;
    text-transform: uppercase;

    h3 {
      font-family: var(--font-typewriter);
      color: var(--color-accent);
    }
  }

  .pricing-card__body {
    --card-line-height: 27px;
    flex-grow: 999;
    padding-inline: var(--space-s);
    padding-block: var(--space-md);
    font-size: var(--fs-md);
    display: flex;
    gap: var(--space-s);
    flex-direction: column;
    background: repeating-linear-gradient(
      transparent,
      transparent var(--card-line-height),
      rgba(122, 158, 172, 0.32) var(--card-line-height),
      rgba(122, 158, 172, 0.32) calc(var(--card-line-height) + 1px)
    );

    ul {
      list-style: none;
      padding: 0;
      margin: 0;

      li {
        line-height: 29px;
        display: flex;
        gap: .5rem; 
        align-items: start;

        .pricing-card__bullet {
          width: .7rem;
          color: var(--color-accent);
        }
      }
    }
  }

  .pricing-card__bottom {
    flex-grow: 999;
    display: grid;
    gap: 3rem;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .pricing-card__notes {
    align-self: center;
    color: rgba(168, 74, 72);
    display: flex;
    gap: 0.5rem;
    flex-direction: column;

    .pricing-card__notes-line {
      width: 20%;
      height: var(--card-line-height);
      display: flex;
    }
  }

  .pricing-card__stamp {
    min-width: 0;
    align-self: center;
    margin-block: auto;
    position: relative;
    width: 150px;
    z-index: 0;
    padding-inline: var(--space-xs);
    padding-block: var(--space-s);
    transform: rotate(-2deg);
    filter: drop-shadow(0 0.1rem 0.1rem rgb(70 50 30 / 14%));

    .pricing-card__price {
      position: relative;
      z-index: 1;
      color: #a35c44;
      font-family: var(--font-display);
      font-size: var(--fs-xl);
      text-wrap: nowrap; 
      display: block; 
      transform: translateX(-5px);

      sup {
        display: inline-block;
        font-size: 1rem;
        margin-inline-end: 0.3rem;
        transform: translateY(-5%);
      }
    }
  }

  .pricing-card__stamp-border {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: #fafafa;
    z-index: 0;
  }

   @container (width <= 34rem) {
    .pricing-card__bottom {
      grid-template-columns: initial;
      gap: var(--space-xs);
      place-items: center;
      margin-block-start: 1rem;
    }

    .pricing-card__stamp {
      transform: rotate(-.5deg);
    }

    .pricing-card__notes {
      text-align: left;

      .pricing-card__notes-line {
        margin: auto;
      }
    }
  }
</style>
