---
const { offsetPct = 0, scale = 1 } = Astro.props; 
import SwooshLine from "components/SwooshLine.astro";
---

<span class="underlined">
  <slot/>
  <span
    class="underlined__line"
    style={`--offset: ${offsetPct}%; --scale: ${scale}`}
    data-line>
    <SwooshLine/>
  </span>
</span>

<style>
   .underlined {
    position: relative;
  }

  .underlined__line {
    position: absolute;
    width: 100%;
    left: 0;
    bottom: var(--offset);
    scale: var(--scale);
  }
</style>