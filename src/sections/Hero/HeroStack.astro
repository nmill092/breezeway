---
import Swoosh from "components/Swoosh.astro";
import SwooshLine from "components/SwooshLine.astro";
---

<div class="hero-stack" data-parallax data-parallax-speed="-30">
  <h1 data-hero-title class="hero-stack__title">
    <span>A living room</span>
    <span>for the whole</span>
    <span>neighborhood.</span>
    <span data-hero-swoosh class="hero-stack__swoosh" aria-hidden="true">
      <Swoosh />
    </span>
  </h1>
  <div data-hero-eyebrow class="hero-stack__eyebrow">
    <span>Your new spot to work, play, relax, or caffeinate –</span>
    <span>all right at home in South Philly.</span>
  </div>
  <div class="hero-stack__cta">
    <a data-hero-cta href="#how" class="pill"> How Breezeway Works </a>
    <div class="hero-stack__hover-line">
      <SwooshLine/>
    </div>
  </div>
</div>

<style>
  .hero-stack {
    grid-area: text;
    place-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-stack__title {
    text-align: center;
    line-height: 0.9;
    font-size: var(--fs-hero);
    font-kerning: normal;
    letter-spacing: -0.015em;
    word-spacing: -0.025em;
    span {
      display: block;
    }
  }

  .hero-stack__eyebrow {
    text-align: center;
    line-height: 1.12;
    white-space: nowrap;
    color: var(--color-ink);
    margin-block-start: var(--space-md);

    span {
      display: block;
    }
  }

  .hero-stack__cta {
    margin-block-start: var(--space-l);
    position: relative;

    .hero-stack__hover-line {
      position: absolute;
      bottom: -50%;
      left: 50%;
      transform: translateX(-50%);
      width: 70%;
      color: var(--color-accent);
      clip-path: inset(0 100% 0 0);
      transition: .5s cubic-bezier(1,-0.01,.36,.72) clip-path;
    }

    &:has(a:focus-visible, a:hover) .hero-stack__hover-line {
     clip-path: inset(0);
    }

    a {
      transition: background-color 0.2s ease;
      &:hover, &:focus-visible {
        background-color: var(--color-accent);
      }
    }
  }

  .hero-stack__swoosh {
    width: 50%;
    margin-inline: auto;
    margin-block-start: var(--space-3xs);
    color: var(--color-accent);
  }
</style>
