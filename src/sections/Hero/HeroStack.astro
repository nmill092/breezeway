---
import Swoosh from "components/Swoosh.astro";
import SwooshLine from "components/SwooshLine.astro";
---

<div class="hero-title-stack">
  <h1 data-hero-title class="title">
    <span>A living room</span>
    <span>for the whole</span>
    <span>neighborhood.</span>
    <div data-hero-swoosh class="swoosh" aria-hidden="true">
      <Swoosh />
    </div>
  </h1>
  <div data-hero-eyebrow class="eyebrow">
    <span>Your new spot to work, play, relax, or caffeinate –</span>
    <span>all right at home in South Philly.</span>
  </div>
  <div class="hero-cta">
    <a data-hero-cta href="#how" class="pill"> How Breezeway Works </a>
    <div class="hover-line">
      <SwooshLine/>
    </div>
  </div>
</div>

<style>
  .hero-title-stack {
    grid-area: text;
    place-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .title {
    text-align: center;
    line-height: 0.9;
    font-size: var(--fs-hero);
    font-kerning: normal;
    letter-spacing: -0.015em;
    word-spacing: -0.025em;
    span {
      display: block;
    }
  }

  .eyebrow {
    text-align: center;
    line-height: 1.12;
    white-space: nowrap;
    color: var(--color-ink);
    margin-block-start: var(--space-md);

    span {
      display: block;
    }
  }

  .hero-cta {
    margin-block-start: var(--space-l);
    position: relative; 

    .hover-line {
      position: absolute; 
      bottom: -50%; 
      left: 50%; 
      transform: translateX(-50%);
      width: 70%;
      color: var(--color-accent);
      clip-path: inset(0 100% 0 0); 
      transition: .5s cubic-bezier(1,-0.01,.36,.72) clip-path; 
    }

    &:has(a:focus-visible, a:hover) .hover-line {
     clip-path: inset(0);
    }

    a {
      transition: background-color 0.2s ease;
      &:hover, &:focus-visible {
        background-color: var(--color-accent);
      }
    }
  }

  .swoosh {
    width: 50%;
    margin-inline: auto;
    margin-block-start: var(--space-3xs);
    color: var(--color-accent);
  }
</style>
