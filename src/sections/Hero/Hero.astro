---
import HeroStack from "./HeroStack.astro";
import Polaroid from "components/Polaroid.astro";

import heroBoardGameImg from "assets/images/hero-boardgames.jpg";
import washi1 from "assets/images/embellishments/washi-1.png";
import washi2 from "assets/images/embellishments/washi-2.png";

import heroLaptop from "assets/images/hero-laptop.jpg";
import HeroChess from "components/HeroChess.astro";
import HeroHiFive from "components/HeroHiFive.astro";

import { getImage } from "astro:assets";
import tornMaskSrc from "assets/images/embellishments/papermask2.png";
import tornTextureSrc from "assets/images/embellishments/tornpapertexture.jpg";

const tornMask = await getImage({
  src: tornMaskSrc,
  format: "webp",
  width: 1440,
});
const tornTexture = await getImage({
  src: tornTextureSrc,
  format: "webp",
  width: 400,
  quality: 80,
  priority: true,
});
---

<section class="hero" id="hero" data-section="hero">
  <div class="container--full-bleed">
    <div class="hero__grid">
      <div data-hero-image data-parallax class="hero__photo hero__photo--br">
        <Polaroid
          img={heroBoardGameImg}
          tapeImg={washi1}
          tapeRotation="2deg"
          variant="landscape"
          paddingVariant="md"
          imgAlt="Several young people sat around a table playing a board game"
          priority={true}
          width={700}
        />
      </div>

      <div data-hero-image data-parallax-speed="10" class="hero__photo hero__photo--tl">
        <Polaroid
          img={heroLaptop}
          tapeImg={washi2}
          tapeRotation="-2deg"
          variant="square"
          paddingVariant="md"
          position="attention"
          imgAlt="A person using a laptop while sitting on a beanbag"
          priority={false}
          width={500}
        />
      </div>
      <HeroStack />
      <div data-hero-image class="hero__illustration hero__illustration--tr">
        <HeroChess />
      </div>
      <div
        data-hero-image
        class="hero__illustration hero__illustration--bl"
        data-parallax
        data-parallax-speed="8"
      >
        <HeroHiFive />
      </div>
    </div>
  </div>
  <div class="torn-edge"></div>
</section>

<style
  define:vars={{
    tornMask: `url(${tornMask.src})`,
    tornTexture: `url(${tornTexture.src})`,
  }}
>
  .hero {
    --torn-edge-height: 70px;
    container-type: inline-size;
    padding-block-start: var(--space-s);
  }

  .hero__grid {
    position: relative;
    display: flex;
    z-index: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    color: var(--color-ink);
    min-height: calc(
      100svh - (var(--header-h) + var(--nav-gap) + var(--torn-edge-height))
    );
  }

  .torn-edge {
    position: relative;
    height: var(--torn-edge-height);
    z-index: 0;
    mask-image: var(--tornMask);
    mask-repeat: repeat-x;
    mask-size: 120% 300%;
    mask-position: 60% 5%;
    background: var(--tornTexture);
    background:
      var(--tornTexture),
      oklch(from var(--color-accent) calc(l + 0.1) c h / 0.1);
    background-size: 500px 50%;
    background-blend-mode: multiply;
  }

  .hero__photo,
  .hero__illustration {
    --nudgeX: 0;
    --nudgeY: 0;
    --rotate: 0;
    min-width: 0;
    transform: translate(var(--nudgeX), var(--nudgeY)) rotate(var(--rotate));
  }

  .hero__photo--tl {
    --rotate: -2.2deg;
    order: 2;
    margin-block-start: 2rem;
    width: clamp(14rem, 75cqi, 22rem);
  }

  .hero__photo--br,
  .hero__illustration--bl,
  .hero__illustration--tr {
    display: none;
  }

  @container (width >= 65rem) {
    .hero__grid {
      display: grid;
      grid-template:
        "photo1 text illustration2"
        "photo1  text  illustration2"
        "illustration1  text photo2"
        "illustration1  text photo2" / minmax(15rem, 1fr) minmax(
          0,
          clamp(27rem, 27.3333rem + 11.8519cqi, 38rem)
        )
        minmax(15rem, 1fr);
    }

    .hero__photo,
    .hero__illustration {
      place-self: center;
      transition: 0.3s scale ease;

      &:hover {
        --rotate: 0;
        scale: 1.02;
      }
    }

    .hero__illustration {
      width: clamp(11rem, 16cqi, 19rem);
    }

    .hero__photo--tl {
      grid-area: photo1;
      width: clamp(15rem, 16cqi, 20rem);
      order: initial;
      margin-block-start: initial;
    }

    .hero__photo--br {
      grid-area: photo2;
      width: clamp(15rem, 22cqi, 25rem);
      display: block;
      --rotate: 2.2deg;
      --nudgeY: calc(var(--torn-edge-height) * 0.6);
    }

    .hero__illustration--bl {
      grid-area: illustration1;
      --nudgeX: 80px;
      --nudgeY: 20px;
      --rotate: -2.8deg;
      display: block;
    }

    .hero__illustration--tr {
      grid-area: illustration2;
      --nudgeX: -47px;
      --nudgeY: -20px;
      --rotate: 2deg;
      display: block;
      order: initial;
    }
  }
</style>

<script>
  import { scoped } from "scripts/gsap";
  import { gsap } from "scripts/gsap";
  import { initParallax } from "scripts/parallax";

  const hero = document.querySelector('[data-section="hero"]');

  if (hero) {
    const { ctx } = scoped(() => {
      let mm = gsap.matchMedia(hero);

      mm.add("(prefers-reduced-motion: no-preference)", () => {
        const images = gsap.utils
          .toArray("[data-hero-image]")
          .filter(
            (el) => getComputedStyle(el as HTMLElement).display !== "none",
          );

        const tl = gsap.timeline({
          delay: 0.2,
          defaults: {
            duration: ".8",
          },
          onComplete: () => {
           ctx.add(() => initParallax(hero, "top top"));
          },
        });

        tl.from("[data-hero-title] span", {
          autoAlpha: 0,
          y: 20,
        })
          .from(
            "[data-hero-swoosh]",
            {
              clipPath: "inset(0 100% 0 0)",
              ease: "power2.out",
            },
            "<.3",
          )
          .from(
            "[data-hero-eyebrow]",
            {
              autoAlpha: 0,
              y: 20,
            },
            ">.3",
          )
          .from(
            "[data-hero-cta]",
            {
              autoAlpha: 0,
              y: 20,
            },
            "<.3",
          )
          .from(
            images,
            {
              autoAlpha: 0,
              "--rotate": 0,
              stagger: 0.2,
            },
            "<.2",
          );
      });
    }, hero);
  }
</script>
