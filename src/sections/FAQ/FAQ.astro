---
import { questions } from "./data";
---

<section class="faq" id="faq" data-section="faq">
  <div class="container">
    <div class="faq__inner">
      <h2 class="faq__heading">Frequently Asked Questions</h2>
      <div class="faq__questions">
        {
          questions.map((question) => (
            <details name="faq" class="faq__details" data-details>
              <summary class="faq__summary" data-summary>
                <span class="faq__question-text"> {question.question}</span>
                <span aria-hidden="true" class="faq__question-toggle" />
              </summary>
              <div class="faq__answer" data-answer>
                <div class="faq__answer-inner" set:html={question.answer} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block-start: var(--section-spacing);
  }

  .faq__inner {
    display: grid;
    gap: var(--space-l);
  }

  .faq__heading {
    font-size: var(--fs-3xl);
    text-align: center;
  }

  .faq__questions {
    display: flex;
    flex-direction: column;
    gap: var(--fs-md);
  }

  .faq__question-text {
    font-family: var(--font-display);
    color: var(--color-accent);
    flex: 1;
    font-size: var(--fs-lg);
  }

  .faq__summary {
    list-style: none;
    display: flex;
    border-bottom: 1px solid var(--color-accent);
    cursor: pointer;
     display: flex;
    align-items: center;
    padding-block: var(--space-3xs);

    &:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 4px;
    }
  }
  
  .faq__answer {
    overflow: clip; 

    & > .faq__answer-inner {
      padding-block: var(--space-xs);
    }
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__question-toggle {
    position: relative;
    --mask-image: url("../../assets/images/embellishments/asterisk.svg");
    flex: 0 0 20px;
    width: 20px;
    height: 20px;

    &::after {
      position: absolute;
      inset: 0; 
      content: "";
      background-color: var(--color-accent);
      -webkit-mask-image: var(--mask-image);
      mask-image: var(--mask-image);
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
    }
  }

  .faq__details[open] .faq__question-toggle::after {
    --mask-image: url("../../assets/images/embellishments/short-line.svg");
  }
</style>

<script>
  import { gsap, reduced, scoped } from "scripts/gsap";

  const root = document.querySelector('[data-section="faq"]') as Element;

  scoped(() => {
  if (!root) return; 

    let mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const details = gsap.utils.toArray(
        "[data-details]",
      ) as HTMLDetailsElement[];

      details.forEach((detail) => {
        const summary = detail.querySelector("[data-summary]");
        const answer = detail.querySelector("[data-answer]");

        if (!summary || !answer) return;

        summary?.addEventListener("click", (e) => {
          e.preventDefault();

          gsap.killTweensOf(answer);

          if (detail.open) {
            gsap.to(answer, {
              height: 0,
              autoAlpha: 0,
              duration: 0.25,
              ease: "power2.inOut",
              onComplete: () => {
                detail.open = false;
              },
            });
          } else {
            detail.open = true;

            gsap.fromTo(
              answer,
              { height: 0, autoAlpha: 0 },
              { 
                height: "auto", 
                autoAlpha: 1,
                duration: 0.35,
                ease: "power2.out" 
              },
            );
          }
        });
      });
    });
  }, root);
</script>
