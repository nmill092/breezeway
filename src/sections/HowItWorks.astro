---
import PricingCard from "components/PricingCard.astro";
import SwooshLine from "components/SwooshLine.astro";
---

<section class="how" id="how" data-section="how">
    <div class="how__stage">

      <div class="how__inner">
  <div class="container">

        <div class="how__content">
          <h2 class="how__lede" data-lede data-reveal>
            At Breezeway, you only pay<br />
            for the <span class="how__underline"
              >time <div class="how__line" data-line><SwooshLine /></div></span
            > you spend.
          </h2>
          <PricingCard />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    position: relative;
    /* padding-block-start: calc(var(--header-h) + var(--nav-gap)); */
  }

  .how__stage {
    height: 100svh;
    width: 100%
  }

  .how__inner {
    height: 100%;
    width: 100%;
    display: grid;
    align-items: center;
  }

  .how__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--fs-4xl);
  }

  .how__lede {
    font-size: var(--fs-3xl);
    line-height: 1;
    text-align: center;
    letter-spacing: -4%;
  }

  .how__underline {
    position: relative;
  }

  .how__line {
    position: absolute;
    width: 80%;
    left: 0;
    bottom: 0;
    clip-path: inset(0% 100% 0% 0%);
  }
</style>

<script>
  import { gsap, scoped } from "scripts/gsap";

  const root = document.querySelector('[data-section="how"]');

  if (root) {
    const { ctx } = scoped(() => {
      let mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
        const lede = document.querySelector("[data-lede]");

        const CARD_FINAL_ROTATION = 1.5; 

        gsap.set("[data-pricing-card]", {
          autoAlpha: 0,
          y: window.innerHeight * 2,
          rotate: -5,
        });

        gsap.set("[data-benefits], [data-card-bottom]", {
          autoAlpha: 0,
        });

        gsap.set(lede, {
          scale: 1.1,
          yPercent: 50,
        });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: root,
            start: "top top",
            end: "+=1000",
            pin: ".how__stage",
            scrub: 1,
          },
          defaults: {
            ease: "power3.inOut",
            duration: 0.8,
          }
        });

        tl.to(lede, {
          yPercent: 0,
          scale: 1,
        })
          .to(
            "[data-line]",
            {
              clipPath: "inset(0% 0% 0% 0%)",
            },
            "<.1",
          )
          .to("[data-pricing-card]", {
            autoAlpha: 1,
            y: 0,
            ease: "power3.out",
            rotate: CARD_FINAL_ROTATION,
          })
          .to("[data-benefits]", {
            autoAlpha: 1,
          })
          .to(
            "[data-card-bottom]",
            {
              autoAlpha: 1,
            },
            "<.2",
          )
          .to({}, { duration: 1 })
      });
    }, root);
  }
</script>
