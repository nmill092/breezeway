---
import Clock from "components/Clock.astro";
import UnderlinedText from "components/UnderlinedText.astro";
import { sections } from "./data";
import Stepper2 from "./Stepper.astro";
import Polaroid from "components/Polaroid.astro";
import Swoosh from "components/Swoosh.astro";
---

<section class="yourday" id="yourday" data-section="yourday">
  <div class="yourday__stage" data-yourday-stage>
    <div class="container">
      <div class="yourday__inner">
        <h2 class="yourday__header">
          <UnderlinedText>Your Day</UnderlinedText> at Breezeway
        </h2>
        <p class="yourday__lede">
          Scroll to see what a day at Breezeway might look like.
        </p>
        <div class="yourday__content">
          <div class="yourday__clock">
            <Clock />
          </div>
          <div class="yourday__stepper">
            <Stepper2 sections={sections} />
          </div>
          <ul class="yourday__sections">
            {
              sections.map((section) => (
                <li
                  class="yourday__section"
                  data-yourday-section
                  style={`--rotation: ${section.rotation}deg`}
                >
                  <div class="yourday__section-header">
                    <div class="yourday__section-time">{section.displayTime}</div>
                    <h3 class="yourday__section-title">{section.title}</h3>
                  </div>
                  <div class="yourday__section-text">{section.text}</div>
                  <div class="yourday__section-image">
                    <Polaroid
                      img={section.image}
                      imgAlt={section.imageAlt}
                      variant="landscape"
                      width={800}
                    />
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .yourday {
    padding-block-start: calc(var(--nav-padding) + var(--space-md));
  }

  .yourday__inner {
    min-height: var(--stage-height);
    display: grid;
    grid-template-rows:
      auto
      auto
      minmax(0, 1fr);
  }

  .yourday__stage {
    --stage-height: calc(100svh - var(--nav-padding) - var(--space-md));
    min-height: var(--stage-height);
    position: relative;
  }

  .yourday__header,
  .yourday__lede {
    text-align: center;
  }

  .yourday__header {
    font-size: var(--fs-3xl);
  }

  .yourday__clock {
    padding: 1rem;
    display: none; 
  }

  .yourday__content {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-md);
    line-height: 1.1;
    grid-template-columns: 2rem minmax(0, 1fr);
    width: min(100%, 31rem);
    justify-self: center;
  }

  @media (width >= 56rem) {
    .yourday__content {
      grid-template-columns: minmax(16rem, 0.7fr) 13rem minmax(24rem, 1.25fr);
      margin-inline: 0; 
    width: 100%;

    }

    .yourday__clock {
      display: grid;
      color: var(--color-accent);
      gap: var(--space-s); 

    }
  }

  .yourday__sections {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 100%;
    min-width: 0; 
  }

  .yourday__section:first-child {
    visibility: visible;
  }

  .yourday__section {
    min-width: 0; 
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: var(--space-s);
    visibility: hidden;
  }

  .yourday__section-header {
    display: grid;
    gap: var(--space-3xs);
  }

  .yourday__section-time {
    font-size: var(--fs-s);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .yourday__section-title {
    font-size: var(--fs-xl);
    line-height: 1;
  }

  .yourday__section-text {
    max-width: 40ch;
  }

  .yourday__section-image {
    min-width: 0;
    width: min(100%, 28rem);
    transform: rotate(var(--rotation));
  }
</style>

<script>
  import { gsap, scoped, ScrollTrigger } from "scripts/gsap";
  import { sections } from "./data";

  const root = document.querySelector('[data-section="yourday"]');

  if (root) {
    scoped(() => {
      const minToAngle = (min: number) => min * 6;
      const hourToAngle = (hour: number, min: number) =>
        30 * (hour % 12) + min / 2;

      const stepsWithAngles = sections.map((section) => ({
        ...section,
        hourAngle: hourToAngle(section.hours, section.minutes),
        minuteAngle: minToAngle(section.minutes),
      }));

      const face = document.querySelector(
        "[data-clock-face]",
      ) as SVGCircleElement;

      if (face) {
        const cx = face.cx.baseVal.value;
        const cy = face.cy.baseVal.value;

        gsap.set("[data-hour-hand], [data-minute-hand]", {
          svgOrigin: `${cx} ${cy}`,
          rotation: 0,
        });
      }

      gsap.set("[data-hour-hand]", {
        rotation: stepsWithAngles[0].hourAngle,
      });

      gsap.set("[data-minute-hand]", {
        rotation: stepsWithAngles[0].minuteAngle,
      });

      const steps = gsap.utils.toArray("[data-yourday-section]") as Element[];
      gsap.set(steps.slice(1), { autoAlpha: 0 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: root,
          start: "top top",
          end: "+=2500",
          pin: "[data-yourday-stage]",
          scrub: 1,
        },
      });

      const stepHold = 1.4;
      const stepFade = 0.4;
      const stepDuration = stepHold + stepFade;

      const stepperSteps = document.querySelectorAll("[data-step]");
      let activeStep = -1;

      const setActiveStep = (i: number) => {
        stepperSteps.forEach((step) => {
          step.classList.toggle(
            "stepper__step--active",
            Number((step as HTMLElement).dataset.stepper) === i,
          );
        });
      };

      const syncActiveStep = () => {
        const index = gsap.utils.clamp(
          0,
          sections.length - 1,
          Math.floor(tl.time() / (stepHold + stepFade)),
        );

        if (index !== activeStep) {
          activeStep = index;
          setActiveStep(index);
        }
      };

      setActiveStep(0);
      activeStep = 0;

      steps.forEach((step, i) => {
        const at = i * stepDuration;

        if (i > 0) {
          tl.to(
            steps[i - 1],
            {
              autoAlpha: 0,
              duration: stepFade,
            },
            at,
          );
        }

        tl.to(
          step,
          {
            autoAlpha: 1,
            duration: stepFade,
          },
          at,
        )
          .to(
            "[data-hour-hand]",
            {
              rotation: `${stepsWithAngles[i].hourAngle}_cw`,
              duration: stepFade,
              ease: "sine.out",
            },
            at,
          )
          .to(
            "[data-minute-hand]",
            {
              rotation: `${stepsWithAngles[i].minuteAngle}_cw`,
              duration: stepFade,
              ease: "power3.out",
            },
            at,
          );
      });

      tl.eventCallback("onUpdate", syncActiveStep);
    }, root);
  }
</script>
