---
import { type YourDaySection } from "./data";

interface Props {
  sections: YourDaySection[];
}

const { sections }: Props = Astro.props;
---

<ol class="stepper" aria-hidden="true">
  {
    sections.map((section, i) => (
      <li
        data-stepper={i}
        class:list={["stepper__step", { "stepper__step--active": i === 0 }]}
        data-step
      >
        <div class="stepper__marker">
          <div class="stepper__indicator" />
        </div>
        <div class="stepper__text">
          <div class="stepper__time">{section.displayTime}</div>
          <div class="stepper__label">{section.title}</div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .stepper {
    --step-gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--step-gap);
    height: 100%;
  }

  .stepper__step {
    display: grid;
    grid-template-columns: 1.3rem 1fr;
    gap: var(--space-xs);
    align-items: stretch;
    flex: 1 1 0;
  }

  .stepper__marker {
    position: relative;
    display: grid;
    place-items: center;
  }

  .stepper__step:not(:last-child) > .stepper__marker::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: calc(100% + var(--step-gap));
    background: var(--color-body);
  }

  .stepper__indicator {
    width: 1.3rem;
    aspect-ratio: 1;
    border: 1px solid var(--color-body);
    border-radius: 50%;
    position: relative;
    z-index: 1;
    background: var(--color-paper);

    &::after {
      position: absolute;
      content: "";
      height: 10%;
      aspect-ratio: 1;
      border: 1px solid var(--color-accent);
      border-radius: 100%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0;
      transition: 0.3s ease all;
    }

    .stepper__step--active & {
      background-color: var(--color-accent);
      box-shadow: 0 0 0 7.5px var(--color-paper);
      z-index: 99;
      border: 1px solid var(--color-accent); 

      &::after {
        height: 200%;
        opacity: 1;
      }
    }
  }

  .stepper__text {
    display: none;
    line-height: 1.2;
    font-size: var(--fs-s);
  }

  .stepper__time {
    align-self: end;
    transition: .2s ease color; 
    
    .stepper__step--active & {
      font-weight: 800;
      color: var(--color-accent);
    }
  }
  .stepper__label {
    align-self: start; 
  }

  .stepper__text {
  display: none;
}

@media (width >= 56rem) {
  .stepper__text {
    display: grid;
  }
}

 @media (prefers-reduced-motion: reduce) {
    .stepper__time {
    transition: none; 
    }

    .stepper__indicator::after {
      transition: none; 
    }
 }
</style>
