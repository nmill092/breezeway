---
import "styles/global.css";

import { Font } from "astro:assets";

import Footer from "components/Footer.astro";
import Header from "components/Header/Header.astro";

import { siteConfig } from "../lib/meta";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { description, title, ogImg } = siteConfig; 

---
<html lang="en">
	<head>
		<meta charset="utf-8" />
	
    <link rel="canonical" href={canonicalURL} />
		 <meta name="viewport" content="width=device-width, initial-scale=1" />
     <meta name="description" content={description} />
     <meta name="robots" content="noindex, nofollow" />

     <!-- OpenGraph props -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImg, Astro.site)} />

    <meta name="theme-color" content="#f0e9d8" />
		<meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-equateur" preload/>
    <Font cssVariable="--font-manrope" preload/>
    <Font cssVariable="--font-nitti-typewriter"/>
    <Font cssVariable="--font-homemade-apple"/>

		<title>{title}</title>
    <slot name="head"/>
	</head>
	<body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header/>
    <main id="main">
      <slot/>
    </main>
    <Footer/>
	</body>
</html>

<style>
  .skip-link {
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
    border-radius: 0 0 3px 3px; 
    top: 0;
    z-index: 1000;
    left: 50%;
    padding: 4px;
    position: fixed;
    transform: translate(-50%, -100%); 
    transition: transform .3s ease; 

    &:focus {
      transform: translate(-50%, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link { 
      transition: none; 
    }
  }
</style>

<script>
  import { initLenis } from "scripts/lenis";

  initLenis();
</script>